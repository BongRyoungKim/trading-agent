# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables (NEVER commit)
.env
.env.local
.env.*.local

# Data & logs (root-level runtime dirs only — do NOT match src/data/, tests/data/, etc.)
/data/
/logs/
!/data/.gitkeep
!/logs/.gitkeep
*.csv
*.db
*.sqlite
/trading-agent-logs/

# SSH keys (NEVER commit)
ssh-key-*
*.pem
*.key

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Generated reports (runtime output)
reports/

# Live-mutable runtime config — ScheduledTaskRunner/dashboard write these
# directly on the server; tracking them in git only produces permanent
# drift (git's copy is always stale the moment the auto-tuner or a mode
# toggle runs). scripts/render_launch_args.py's DEFAULT_STRATEGY_PARAMS/
# DEFAULT_RISK are the versioned baseline; these files are the live
# server-local override, same category as .env.
.strategy_params.json
.trading_mode
.strategy_params.json.bak-*
